# ==============================================================================
# Enterprise IT Support Copilot - Configuration
# ==============================================================================

# Application Environment
APP_ENV=development
ADMIN_API_KEY=change-me-in-production

# ------------------------------------------------------------------------------
# Option 1: Using Groq (OpenAI-Compatible Base URL & Groq API Key)
# ------------------------------------------------------------------------------
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_API_KEY=gsk_your_groq_api_key_here
OPENAI_MODEL=llama-3.3-70b-versatile

# Since Groq does NOT host an embeddings API, embeddings will automatically use 
# Pinecone Hosted Embeddings (multilingual-e5-large) using your PINECONE_API_KEY.
# (Or set EMBEDDING_PROVIDER=fastembed for local CPU embeddings)
EMBEDDING_PROVIDER=auto
EMBEDDING_MODEL=multilingual-e5-large

# ------------------------------------------------------------------------------
# Option 2: Using OpenAI (Uncomment if using direct OpenAI)
# ------------------------------------------------------------------------------
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=sk-your_openai_api_key_here
# OPENAI_MODEL=gpt-4o-mini
# EMBEDDING_PROVIDER=openai
# EMBEDDING_MODEL=text-embedding-3-small

# ------------------------------------------------------------------------------
# External Search (Tavily)
# ------------------------------------------------------------------------------
TAVILY_API_KEY=tvly-your_tavily_api_key_here

# ------------------------------------------------------------------------------
# Vector Database (Pinecone)
# ------------------------------------------------------------------------------
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=fde-it-support-rag
PINECONE_NAMESPACE=company-it-kb
